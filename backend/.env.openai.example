# OpenAI default config (recommended quick start)
APP_NAME=AI Resume Analyzer
REDIS_URL=
ENABLE_LLM=true
LLM_PROVIDER=openai
LLM_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o-mini
ENABLE_OCR=true
OCR_DPI=220
OCR_MAX_PAGES=3
MAX_UPLOAD_BYTES=10485760
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_KEY_MAX_LENGTH=128
CORS_ALLOW_ORIGINS=*
